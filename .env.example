# Desenvolvimento: banco isolado. Use a URL com pooling no aplicativo em produção.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jmonitora
# Gere uma chave privada: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_NAME=Administrador JM Monitora
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
PORT=3000
NODE_ENV=development
PG_POOL_MAX=5
# Opcional: origem canônica exata, sem caminho, para validar requisições do navegador.
# APP_ORIGIN=https://seu-dominio.vercel.app
# Apenas em ambiente isolado: força a migração no build de preview.
# RUN_DB_MIGRATIONS=true
