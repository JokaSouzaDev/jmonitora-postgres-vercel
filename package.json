{
  "name": "sistema-jmonitora",
  "version": "2.0.0",
  "private": true,
  "description": "JM Monitora: acompanhamento pedagógico mobile first, identificação por RA e devolutivas entre monitores e professores",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx scripts/dev-server.ts",
    "build": "tsc --noEmit",
    "start": "node --import tsx scripts/dev-server.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:import-json": "node --import tsx scripts/import-json.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "build:vercel": "npm run build && node --import tsx scripts/vercel-build.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
